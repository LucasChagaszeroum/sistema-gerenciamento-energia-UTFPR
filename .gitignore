# === AMBIENTE VIRTUAL E DEPENDÊNCIAS ===
venv/
env/
ENV/
.venv/

# === CACHES E ARQUIVOS TEMPORÁRIOS DO PYTHON ===
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# === BANCO DE DADOS LOCAL E ARQUIVOS DE DADOS ===
# Ignora bancos e logs locais para não sujar o histórico de commits do GitHub
*.db
*.sqlite
*.sqlite3
*.log

# === CONFIGURAÇÕES DO VS CODE E DO STREAMLIT ===
.vscode/
.streamlit/secrets.toml

# === VARIÁVEIS DE AMBIENTE E SEGURANÇA ===
# Nunca suba senhas, tokens ou chaves de API para o repositório
.env
.env.local

# === ARQUIVOS DE COMPILAÇÃO E DUMP DE MODELOS ===
*.pkl
*.pth
*.onnx

# === ARQUIVOS TEMPORÁRIOS DO SISTEMA ===
.DS_Store
Thumbs.db